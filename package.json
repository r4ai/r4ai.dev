{
  "name": "r4ai-dev",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "type-check": "astro check",
    "lint": "eslint .",
    "lint:write": "eslint --fix .",
    "format": "prettier --ignore-path .gitignore --check './**/*.{js,cjs,mjs,ts,jsx,tsx,astro,json,html,md}'",
    "format:write": "prettier --ignore-path .gitignore --write './**/*.{js,cjs,mjs,ts,jsx,tsx,astro,json,html,md}'",
    "check": "pnpm run lint && pnpm run format",
    "check:write": "pnpm run lint:write && pnpm run format:write",
    "astro": "astro",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:ci:unit": "vitest run src/lib && node --test tests/remark-link-card.node-test.ts scripts/security/*.test.ts",
    "test:coverage": "vitest run src/lib --coverage --coverage.include='src/lib/**/*.ts' --coverage.exclude='**/*.d.ts'",
    "test:vrt:unit": "node --test tests/storybook/*.node-test.ts",
    "test:vrt": "playwright test --config=playwright.vrt.config.ts",
    "test:vrt:update": "playwright test --config=playwright.vrt.config.ts --update-snapshots"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/solid-js": "^7.0.2",
    "@corvu/drawer": "^0.2.4",
    "@formkit/tempo": "^0.1.2",
    "@kobalte/core": "^0.13.14",
    "@kobalte/utils": "^0.9.2",
    "@modular-forms/solid": "0.25.1",
    "astro": "^7.3.2",
    "clsx": "^2.1.1",
    "katex": "^0.16.47",
    "mermaid": "^11.17.2",
    "scule": "^1.3.0",
    "shiki": "^4.4.3",
    "solid-js": "^1.9.15",
    "solid-sonner": "^0.3.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "three": "^0.180.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "9.39.5",
    "@iconify-json/fluent-emoji": "1.2.7",
